							},
							{
								"source": {
									"name": ""
								},
								"sink": {
									"name": "table_names",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": ""
								},
								"sink": {
									"name": "loadType",
									"type": "String",
									"physicalType": "varchar"
