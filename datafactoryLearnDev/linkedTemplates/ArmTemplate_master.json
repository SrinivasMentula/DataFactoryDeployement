{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactoryLearnDev"
		},
		"ls_teststorageaccount_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_teststorageaccount'"
		},
		"ls_azuresqldatbase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverlearndev.database.windows.net"
		},
		"ls_azuresqldatbase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().databaseName}"
		},
		"ls_azuresqldatbase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "MentulaSrinivas"
		},
		"ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://learnkeyvaultmenthula.vault.azure.net/"
		},
		"ls_storageAccount_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://learndatabricksazure.blob.core.windows.net/"
		},
		"ls_storageAccount_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "675380b9-575c-43fc-a696-a5f3809b55be"
		},
		"ls_storageAccount_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "722d4b82-a332-4fbb-98dd-c2d9dca1b3c5"
		},
		"demoTumblingWindowTriggger_properties_pipeline_parameters_windowStartTime": {
			"type": "string",
			"defaultValue": "@triggerOutputs().windowStartTime"
		},
		"demoTumblingWindowTriggger_properties_pipeline_parameters_windowEndTime": {
			"type": "string",
			"defaultValue": "@triggerOutputs().windowEndTime"
		},
		"eventTriggerExample_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/09b1704d-52a6-4805-9f92-2f0b66b025e2/resourceGroups/rg-databrickslearn-mentula/providers/Microsoft.Storage/storageAccounts/learndatabricksazure"
		},
		"default_properties_env_value": {
			"type": "string",
			"defaultValue": "Dev"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactoryLearnDev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_teststorageaccount_connectionString": {
						"value": "[parameters('ls_teststorageaccount_connectionString')]"
					},
					"default_properties_env_value": {
						"value": "[parameters('default_properties_env_value')]"
					},
					"ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"ls_azuresqldatbase_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresqldatbase_properties_typeProperties_server')]"
					},
					"ls_azuresqldatbase_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresqldatbase_properties_typeProperties_database')]"
					},
					"ls_azuresqldatbase_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresqldatbase_properties_typeProperties_userName')]"
					},
					"ls_storageAccount_properties_typeProperties_serviceEndpoint": {
						"value": "[parameters('ls_storageAccount_properties_typeProperties_serviceEndpoint')]"
					},
					"ls_storageAccount_properties_typeProperties_tenant": {
						"value": "[parameters('ls_storageAccount_properties_typeProperties_tenant')]"
					},
					"ls_storageAccount_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('ls_storageAccount_properties_typeProperties_servicePrincipalId')]"
					},
					"demoTumblingWindowTriggger_properties_pipeline_parameters_windowStartTime": {
						"value": "[parameters('demoTumblingWindowTriggger_properties_pipeline_parameters_windowStartTime')]"
					},
					"demoTumblingWindowTriggger_properties_pipeline_parameters_windowEndTime": {
						"value": "[parameters('demoTumblingWindowTriggger_properties_pipeline_parameters_windowEndTime')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "datafactoryLearnDev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafactoryLearnDev_ArmTemplate_0')]"
			]
		},
		{
			"name": "datafactoryLearnDev_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"eventTriggerExample_properties_typeProperties_scope": {
						"value": "[parameters('eventTriggerExample_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafactoryLearnDev_ArmTemplate_1')]"
			]
		}
	]
}