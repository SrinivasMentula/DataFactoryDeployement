{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactoryLearnDev"
		},
		"eventTriggerExample_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/09b1704d-52a6-4805-9f92-2f0b66b025e2/resourceGroups/rg-databrickslearn-mentula/providers/Microsoft.Storage/storageAccounts/learndatabricksazure"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_productMaintaince')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "chapter7"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_azureSQLDB",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "separtingTheColumns"
						}
					],
					"udfLibraries": [
						{
							"referenceName": "testFuncation",
							"type": "DataFlowReference"
						}
					],
					"scriptLines": [
						"source(output(",
						"          salesMonth as date,",
						"          Retailer as string,",
						"          Product as string,",
						"          SalesValueUSD as decimal(34,2),",
						"          unitsSold as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(weightString = :weighString,",
						"          weightUnit = :WeightUnit,",
						"          productName = :productName,",
						"          LibraryFunctionTesting = AddingTwoValues(unitsSold,unitsSold),",
						"          weighString := right(Product,(locate(' ', reverse(Product))-1) ),",
						"          WeightUnit := iif(endsWith(Product,'oz'),'oz','g' ),",
						"          productName := left(Product,(locate(' ', reverse(Product))-1))) ~> separtingTheColumns",
						"separtingTheColumns sink(validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     store: 'cache',",
						"     format: 'inline',",
						"     output: true,",
						"     saveOrder: 1) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow_7_copy1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "chapter7"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_salesApril",
								"type": "DatasetReference"
							},
							"name": "chapter7"
						},
						{
							"linkedService": {
								"referenceName": "ls_teststorageaccount",
								"type": "LinkedServiceReference"
							},
							"name": "inLineExchangerate"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ls_salesDataProcessed",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "FfilteringProducts"
						},
						{
							"name": "USDExchangeRates"
						},
						{
							"name": "lookup1"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "select1"
						}
					],
					"scriptLines": [
						"parameters{",
						"     pipelineRunsequentialNumber as string ('TestRun')",
						"}",
						"source(output(",
						"          Period as date,",
						"          Product as string,",
						"          {Unit Price} as double,",
						"          Currency as string,",
						"          {Units Sold} as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> chapter7",
						"source(output(",
						"          FromCurrency as string,",
						"          ToCurrency as string,",
						"          Date as date,",
						"          ExchangeRate as double",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: true,",
						"     format: 'excel',",
						"     container: 'chapter7',",
						"     fileName: 'ExchangeRates.xlsx',",
						"     sheetName: 'Sheet1',",
						"     firstRowAsHeader: true) ~> inLineExchangerate",
						"chapter7 filter(Product != 'Month Total') ~> FfilteringProducts",
						"inLineExchangerate filter(ToCurrency == 'USD') ~> USDExchangeRates",
						"FfilteringProducts, USDExchangeRates lookup(Currency == FromCurrency",
						"     && Period == Date,",
						"     multiple: true,",
						"     broadcast: 'auto')~> lookup1",
						"lookup1 derive(SalesValueUSD = toDecimal({Unit Price}*{Units Sold}*ExchangeRate,34,2),",
						"          RunSeqNo = $pipelineRunsequentialNumber,",
						"          Retailer = 'Jolly Good Ltd') ~> derivedColumn1",
						"derivedColumn1 select(mapColumn(",
						"          SalesMonth = Period,",
						"          Product,",
						"          Currency,",
						"          UnitsSold = {Units Sold},",
						"          SalesValueUSD,",
						"          Retailer,",
						"          RunSeqNo",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          period as date,",
						"          product as string,",
						"          currency as string,",
						"          unitsSold as integer,",
						"          salesValueUSD as decimal(34,2),",
						"          RunSeqNo as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          period = SalesMonth,",
						"          product = Product,",
						"          currency = Currency,",
						"          unitsSold = UnitsSold,",
						"          salesValueUSD = SalesValueUSD,",
						"          RunSeqNo",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_datFlowTrigger')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
