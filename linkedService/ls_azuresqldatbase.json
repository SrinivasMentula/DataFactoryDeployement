{
	"name": "ls_azuresqldatbase",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"datbaseName": {
				"type": "String",
				"defaultValue": "sqlDatabaseLearnMentula"
			}
		},
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "sqlserverlearndev.database.windows.net",
			"database": "@{linkedService().databaseName}",
			"encrypt": "mandatory",
			"trustServerCertificate": true,
			"authenticationType": "SQL",
			"userName": "MentulaSrinivas",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_keyvault",
					"type": "LinkedServiceReference"
				},
				"secretName": "sqldatbasePassword"
			}
		}
	}
}